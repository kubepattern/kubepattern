# Krateo case study: cluster, platform and blueprint pins (source before any shared script).
# The shared scripts (../../env/versions.env) honour these overrides.
export KP_PROFILE=kp-krateo
export MINIKUBE_CPUS=12
export MINIKUBE_MEMORY=16g
export MINIKUBE_DISK=60g
export KUBERNETES_VERSION=v1.34.4
# Engine under test: the as-is engine of the main results.
export KP_COMMIT="${KP_COMMIT:-69d4ffd}"

# --- Krateo PlatformOps (https://github.com/krateoplatformops/releases) ---
export KRATEO_VERSION=3.0.2
export KRATEOCTL_VERSION=1.2.1
export KRATEO_NAMESPACE=krateo-system
# no-finops: the FinOps stack (CrateDB, exporters, OPA) is not needed by the case study.
export KRATEO_PROFILES=no-finops

# --- Blueprints (https://marketplace.krateo.io) ---
export MARKETPLACE_URL=https://marketplace.krateo.io
export PORTAL_BLUEPRINT_PAGE_VERSION=1.0.9            # latest published; the given Pattern expects v1-0-10
export PORTAL_COMPOSITION_PAGE_GENERIC_VERSION=1.4.3  # dependency of the official app blueprints
export BLUEPRINT_NAME=springboot-app
export BLUEPRINT_VERSION=1.0.0                        # -> composition.krateo.io/v1-0-0, kind SpringbootApp
export CHART_REPO_NAMESPACE=kp-charts
export CHART_REPO_URL=http://charts.kp-charts.svc.cluster.local
