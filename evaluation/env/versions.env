# Pinned versions for the KubePattern evaluation (sourced by every script).
# Platform versions were verified against upstream release assets in September 2026.

# --- Cluster ---
KP_PROFILE=kp-eval
KUBERNETES_VERSION=v1.34.4
MINIKUBE_CPUS=8
MINIKUBE_MEMORY=16g
MINIKUBE_DISK=80g

# --- KubePattern under test ---
# Default: the engine evaluated as-is. Override KP_COMMIT (e.g. the per-pattern prune fix)
# to build, install and measure another engine version with the same scripts.
: "${KP_COMMIT:=69d4ffd}"
: "${KP_IMAGE:=localhost/kubepattern:eval-${KP_COMMIT}}"
: "${KP_BIN:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/bin/kubepattern-${KP_COMMIT}}"
KP_NAMESPACE=kubepattern
KP_RELEASE=kubepattern
KP_SA=system:serviceaccount:kubepattern:kubepattern-sa

# --- Subject platforms ---
CERT_MANAGER_VERSION=v1.21.2
CNPG_VERSION=1.30.1
ESO_CHART_VERSION=2.11.0
FLUX_VERSION=v2.9.5
ARGOCD_CHART_VERSION=10.9.2
KARGO_VERSION=1.11.4
CROSSPLANE_VERSION=2.4.2
KUBEVELA_VERSION=1.11.0
CAPI_VERSION=v1.14.2

# --- RQ6 comparison baseline (installed only by env/install/95-kyverno.sh) ---
KYVERNO_CHART_VERSION=3.9.1   # Kyverno v1.19.1
KYVERNO_NAMESPACE=kyverno
